{
  "name": "polar",
  "private": true,
  "version": "0.17.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns='tests/dom/**' tests && bun run test:dom",
    "test:dom": "bun test --preload ./tests/dom/setup.ts tests/dom",
    "tauri": "tauri",
    "app": "tauri dev",
    "index": "cargo run -p polar-index --features server"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dicebear/core": "^9.4.2",
    "@dicebear/glass": "^9.4.2",
    "@dicebear/notionists": "^9.4.2",
    "@dicebear/thumbs": "^9.4.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
