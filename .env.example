# Account backend (Supabase). Copy to .env and fill in. Both values are public
# by design: the publishable key only allows what row-level security permits.
# Leave them out to run Polarity without accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# CAPTCHA on sign-in: the Cloudflare Turnstile site key (public too). Only needed
# once CAPTCHA is turned on in the Supabase dashboard (docs/supabase-storage.md §8).
VITE_CAPTCHA_SITE_KEY=
