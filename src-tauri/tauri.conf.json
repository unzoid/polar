{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polar",
  "version": "0.14.0",
  "identifier": "app.getpolar.desktop",
  "build": {
    "beforeDevCommand": "bun scripts/fetch-mpv.ts && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/fetch-mpv.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Polar",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-blink-features=AudioVideoTracks --autoplay-policy=no-user-gesture-required",
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' data: blob: https: http:",
        "font-src": "'self' data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://127.0.0.1:* http://localhost:*",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MDA2MTJDQjMzOTQ5Q0YKUldUUFNUbXpMR0VBV1lvdWtnSm9hRnRBa0VGbDArZUVLV3ZVbWI1R2I5OEg1YTl5bXJxTmZiaEsK",
      "endpoints": ["https://github.com/unzoid/polar/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/mpv/mpv.exe": "mpv.exe",
      "vendor/mpv/d3dcompiler_43.dll": "d3dcompiler_43.dll",
      "vendor/mpv/LICENSE.GPL.txt": "licenses/mpv/LICENSE.GPL.txt",
      "vendor/mpv/COPYRIGHT.txt": "licenses/mpv/COPYRIGHT.txt"
    }
  }
}
