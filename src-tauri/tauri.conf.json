{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polar",
  "version": "0.1.2",
  "identifier": "app.getpolar.desktop",
  "build": {
    "beforeDevCommand": "bun scripts/fetch-mpv.ts && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/fetch-mpv.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Polar",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-blink-features=AudioVideoTracks",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/mpv/mpv.exe": "mpv.exe",
      "vendor/mpv/d3dcompiler_43.dll": "d3dcompiler_43.dll",
      "vendor/mpv/LICENSE.GPL.txt": "licenses/mpv/LICENSE.GPL.txt",
      "vendor/mpv/COPYRIGHT.txt": "licenses/mpv/COPYRIGHT.txt"
    }
  }
}
